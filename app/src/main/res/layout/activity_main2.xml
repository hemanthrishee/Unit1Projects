<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/unit1Link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unit 1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.142" />

    <Button
        android:id="@+id/unit2Link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unit 2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/unit1Link"
        app:layout_constraintVertical_bias="0.044" />

    <Button
        android:id="@+id/unit3Link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unit 3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/unit2Link"
        app:layout_constraintVertical_bias="0.072" />

    <Button
        android:id="@+id/unit4Link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unit 4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/unit3Link"
        app:layout_constraintVertical_bias="0.072" />

    <Button
        android:id="@+id/unit5Link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unit 5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/unit4Link"
        app:layout_constraintVertical_bias="0.08" />

    <Button
        android:id="@+id/unit6Link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unit 6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/unit5Link"
        app:layout_constraintVertical_bias="0.076" />

</androidx.constraintlayout.widget.ConstraintLayout>